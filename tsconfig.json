{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"declaration": false,
		"declarationMap": false,
		"incremental": true,
		"jsx": "preserve",
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"noEmit": true,
		"plugins": [{ "name": "next" }],
		"types": ["node", "bun"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".next", ".turbo"]
}
