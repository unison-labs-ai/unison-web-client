# Base URL of the Unison API the web client talks to (REST + SSE).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase project the client authenticates against.
# The publishable (anon) key is a client-side public value — safe to ship,
# provided Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: email domain that unlocks internal-only observability surfaces.
# UI affordance only — the API enforces the same check server-side. Leave unset
# in public deployments.
# NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=@example.com
