{
	"name": "unison-web-client",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": ["packages/*"],
		"catalog": {
			"@types/bun": "^1.3.0",
			"@types/react": "^19.0.0",
			"typescript": "^6.0.0",
			"zod": "^4.3.0"
		}
	},
	"scripts": {
		"build": "next build",
		"clean": "rm -rf .next .turbo",
		"dev": "next dev -p 3001",
		"lint": "biome check app src next.config.ts next-env.d.ts postcss.config.ts middleware.ts",
		"format": "biome format --write .",
		"start": "next start -p 3001",
		"test": "bun test --path-ignore-patterns '**/*.{db,e2e,live}.test.*'",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.0",
		"@radix-ui/react-checkbox": "^1.3.0",
		"@radix-ui/react-dialog": "^1.1.0",
		"@radix-ui/react-dropdown-menu": "^2.1.0",
		"@radix-ui/react-label": "^2.1.0",
		"@radix-ui/react-popover": "^1.1.0",
		"@radix-ui/react-scroll-area": "^1.2.0",
		"@radix-ui/react-select": "^2.2.0",
		"@radix-ui/react-separator": "^1.1.0",
		"@radix-ui/react-slot": "^1.2.0",
		"@radix-ui/react-tabs": "^1.1.0",
		"@radix-ui/react-tooltip": "^1.1.0",
		"@supabase/ssr": "^0.6.0",
		"@supabase/supabase-js": "^2.107.0",
		"@tanstack/react-query": "^5.0.0",
		"@tanstack/react-virtual": "^3",
		"@tiptap/react": "^3.26.1",
		"@tiptap/starter-kit": "^3.26.1",
		"@unison/client-core": "workspace:*",
		"@unison/contracts": "workspace:*",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"cmdk": "^1.0.0",
		"geist": "^1.3.0",
		"lucide-react": "^1.17.0",
		"marked": "^18.0.5",
		"next": "^16.0.0",
		"qrcode.react": "^4.2.0",
		"react": "19.2.3",
		"react-day-picker": "^9.11.0",
		"react-dom": "19.2.3",
		"sonner": "^2.0.0",
		"tailwind-merge": "^3.0.0",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@tailwindcss/postcss": "^4.0.0",
		"@types/bun": "catalog:",
		"@types/node": "^25.9.1",
		"@types/react": "catalog:",
		"@types/react-dom": "^19.2.0",
		"@types/turndown": "^5.0.6",
		"@unison/testkit": "workspace:*",
		"tailwindcss": "^4.0.0",
		"typescript": "catalog:"
	}
}
